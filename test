#!/usr/bin/env bash
set -euo pipefail

if [ -z "${ZIG_GLOBAL_CACHE_DIR:-}" ]; then
	zig_global_cache_dir="${TMPDIR:-/tmp}/zig-global-cache"
	export ZIG_GLOBAL_CACHE_DIR="$zig_global_cache_dir"
fi

zig build test

# Corrupt-input tests must also run with safety checks on: ReleaseFast wraps
# integer overflow silently, so only a checked build turns it into a failure.
zig build test -Doptimize=ReleaseSafe -Dtest-filter="corrupt input"

# Differential sweep classifier (injected verdicts and real exit statuses),
# and a compile check of the sweep driver itself; the sweep is a separate,
# bounded campaign: tests/differential/sniper-vs-reference.
luajit tests/differential/classify-test
luajit -bl tests/differential/sniper-vs-reference >/dev/null
# Replay runner controls: injected failing steps must never yield a green run.
tests/differential/replay-runner-test

./tests/cli_test
