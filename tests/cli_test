#!/usr/bin/env bash
set -u

if [ -f "$HOME/dotfiles/bin/src/capture.bash" ]; then
	source "$HOME/dotfiles/bin/src/capture.bash"
else
	capture() {
		local use_printable_binary=0
		while [ $# -gt 0 ]; do
			case "${1-}" in
				-p|--printable-binary)
					use_printable_binary=1
					shift
					;;
				--test)
					# Run tests in a subshell to avoid polluting the current environment
					(
						local test_file
						test_file="$(dirname "${BASH_SOURCE[0]}")/test/capture_test"
						if [[ -f "$test_file" ]]; then
							# Since this script is now sourced, the test must also source it.
							exec "$test_file" >/dev/null
						else
							echo "Test file not found: $test_file" >&2
							exit 127
						fi
					)
					return $?
					;;
				-a|--about)
					echo "capture: capture stdout, stderr, and return/exit code into pre-declared vars: out, err, rc."
					return 0
					;;
				-h|--help)
					cat <<'EOF'
usage: capture [-p|--printable-binary] [--] command [args...]

Runs the command and captures:
	- stdout -> variable: out
	- stderr -> variable: err
	- return/exit code -> variable: rc

Options:
	-p, --printable-binary
		Process stdout and stderr through the `printable_binary` utility
		to make them safe for storing in Bash variables (handles NULs
		and other control characters). It can also decode printable_binary
		output back into a string or to a file via `printable_binary -d`.

Requirements:
	- This function must be sourced.
	- Bash 4.0+ (for printf %q).
	- In the caller's scope, variables "out", "err", and "rc" must already exist, e.g.:

			local out err rc
			capture some_command ...

	- To run a command whose name starts with "-", use:

			capture -- -weirdcmd ...
EOF
					return 0
					;;
				--)
					shift
					break
					;;
				*) # Unknown argument or option
					break
					;;
			esac
		done
		if [[ $# -eq 0 ]]; then
			printf 'capture: no command given\n' >&2
			return 2
		fi
		# Check for printable_binary if requested
		local _old_pb_mute_stats
		if (( use_printable_binary )); then
			if ! command -v printable_binary &> /dev/null; then
				printf 'capture: command not found: printable_binary\n' >&2
				return 127
			fi
			# Mute printable_binary's statistics output that goes to stderr, if not already muted
			_old_pb_mute_stats=$PRINTABLE_BINARY_MUTE_STATS
			export PRINTABLE_BINARY_MUTE_STATS=true
		fi
		# Verify that out/err/rc exist in the dynamic scope (caller locals or globals)
		local v
		for v in out err rc; do
			# Using declare -p is more robust for checking variable existence across scopes.
			if ! declare -p "$v" &>/dev/null; then
				printf 'capture: required variable "%s" is not declared in caller scope\n' "$v" >&2
				return 2
			fi
		done
		(( use_printable_binary )) && _filter="printable_binary" || _filter="cat"
		local __out __err __rc
		# We source the output of the block, which contains 'declare -- __out="..."' etc.
		# FD 3 is used to route filtered stderr around the inner stdout capture.
		# FD 4 is used to route the variable definitions to the 'source' command.
		. <(
			{
				__err=$(
					{
						__out=$(
							set -o pipefail
							# A. Run command
							# B. Redirect Stderr -> Process Sub (Filter -> FD 3)
							# C. Pipe Stdout -> Filter -> Stdout (Captured by __out=)
							"$@" 2> >($_filter >&3) | $_filter
						)
						__rc=$?

						# D. Send captured __out and __rc to FD 4
						declare -p __out __rc >&4
					} 3>&1
					# E. Redirect FD 3 (Filtered Stderr) back to FD 1 for __err=$()
				)
				# F. Send captured __err to FD 4
				declare -p __err >&4

			} 4>&1
		)

		# Restore printable_binary's statistics output that goes to stderr, if not already muted
		if (( use_printable_binary )); then
			export PRINTABLE_BINARY_MUTE_STATS="$_old_pb_mute_stats"
		fi

		# Transfer the data from our safe locals to the caller's variables.
		out="$__out"
		err="$__err"
		rc="$__rc"
	}
fi

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_cmd="$root_dir/build"
failures=0

# Setup problems end the run; assertion failures are counted and reported.
die() {
	echo "cli_test: $*" >&2
	exit 1
}
fail() {
	echo "FAIL: $*" >&2
	failures=$((failures + 1))
}

work_dir="$TMPDIR/bzip2z-cli-$RANDOM-$$"
mkdir -p "$work_dir" || die "cannot create $work_dir"
trap 'rm -rf "$work_dir"' EXIT

cd "$root_dir" || die "cannot enter $root_dir"

# The reference bzip2 is a required interop oracle, not an optional extra.
command -v bzip2 >/dev/null 2>&1 || die "reference bzip2 not found in PATH"

# Allow CI / nix-build to skip the implicit rebuild — when SKIP_BUILD=1, the
# caller has already prepared zig-out/bin (and possibly wrapped binaries with
# patchShebangs / loader wrappers). Re-running ./build inside a Nix sandbox
# would call `nix build` recursively, which either fails or overwrites the
# wrapped binaries with raw ELFs that lack a usable dynamic interpreter.
if [ "${SKIP_BUILD:-0}" != "1" ]; then
	build_log="$work_dir/build.log"
	if ! "$build_cmd" >"$build_log" 2>&1; then
		cat "$build_log" >&2
		die "build failed"
	fi
fi

bin_dir="$root_dir/zig-out/bin"
cli="${BZIP2Z_CLI:-$bin_dir/bzip2z}"

[ -x "$cli" ] || die "bzip2z binary not found at $cli"

printf '%s' "The quick brown fox jumps over the lazy dog.
Pack my box with five dozen liquor jugs." >"$work_dir/sample.txt" || die "cannot write sample"
cp "$work_dir/sample.txt" "$work_dir/sample.orig" || die "cannot copy sample"

out=""
err=""
rc=0

# about flag
capture "$cli" --about
[ "$rc" -eq 0 ] || fail "--about exited $rc"
[ -z "$err" ] || fail "--about wrote to stderr: $err"
# One line naming the version and the platform the binary was built for
# (this test runs the binary on its build host).
[ "$(printf '%s\n' "$out" | wc -l)" -eq 1 ] || fail "--about printed more than one line: $out"
about_version="$(sed -n 's/^[[:space:]]*\.version = "\(.*\)",$/\1/p' "$root_dir/build.zig.zon")"
case "$(uname -s)" in Darwin) about_os=macos ;; Linux) about_os=linux ;; *) about_os="$(uname -s)" ;; esac
case "$(uname -m)" in arm64|aarch64) about_arch=aarch64 ;; *) about_arch="$(uname -m)" ;; esac
case "$out" in
	"bzip2z $about_version"[:\ ]*"$about_os $about_arch"*) ;;
	*) fail "--about should name bzip2z $about_version and $about_os $about_arch: $out" ;;
esac

# compress file
capture "$cli" -k "$work_dir/sample.txt"
[ "$rc" -eq 0 ] || fail "compress exited $rc"
[ -z "$err" ] || fail "compress wrote to stderr: $err"
[ -f "$work_dir/sample.txt.bz2" ] || fail "compressed file missing"

# test integrity
capture "$cli" -t "$work_dir/sample.txt.bz2"
[ "$rc" -eq 0 ] || fail "test mode exited $rc"
[ -z "$err" ] || fail "test mode wrote to stderr: $err"

# decompress to stdout
capture "$cli" -dc "$work_dir/sample.txt.bz2"
[ "$rc" -eq 0 ] || fail "decompress to stdout exited $rc"
[ -z "$err" ] || fail "decompress to stdout wrote to stderr: $err"
diff -u "$work_dir/sample.txt" <(printf '%s' "$out") >/dev/null || fail "stdout decompression mismatch"

# round-trip with system bzip2
capture bzip2 -k -f "$work_dir/sample.txt"
[ "$rc" -eq 0 ] || fail "system bzip2 exited $rc"
[ -z "$err" ] || fail "system bzip2 wrote to stderr: $err"

rm -f "$work_dir/sample.txt"

capture "$cli" -dk "$work_dir/sample.txt.bz2"
[ "$rc" -eq 0 ] || fail "zig bzip2 decompress exited $rc"
[ -z "$err" ] || fail "zig bzip2 decompress wrote to stderr: $err"
diff -u "$work_dir/sample.orig" "$work_dir/sample.txt" >/dev/null || fail "round-trip mismatch"

# bzcat binary
capture "$bin_dir/bzcatz" "$work_dir/sample.txt.bz2"
[ "$rc" -eq 0 ] || fail "bzcat exited $rc"
[ -z "$err" ] || fail "bzcat wrote to stderr: $err"
diff -u "$work_dir/sample.orig" <(printf '%s' "$out") >/dev/null || fail "bzcat output mismatch"

# -j parallel multi-stream (round-trip, stdout)
big_src="$work_dir/big.bin"
big_orig="$work_dir/big.orig"
# Seeded incompressible bytes, identical on every run.
"$root_dir/tests/lib/seeded-bytes" 20261011 2000000 >"$big_src" || die "cannot write seeded input"
cp "$big_src" "$big_orig" || die "cannot copy seeded input"

capture "$cli" -j 2 -k "$big_src"
[ "$rc" -eq 0 ] || fail "parallel compress exited $rc"
[ -z "$err" ] || fail "parallel compress wrote to stderr: $err"
[ -f "$big_src.bz2" ] || fail "parallel compressed file missing"

big_out="$work_dir/big.out"
"$cli" -j 2 -dc "$big_src.bz2" >"$big_out" 2>"$work_dir/big.err" || fail "parallel decompress to stdout failed"
[ -s "$work_dir/big.err" ] && fail "parallel decompress wrote to stderr: $(cat "$work_dir/big.err")"
diff -u "$big_orig" "$big_out" >/dev/null || fail "parallel stdout decompression mismatch"

# Diagnostics in the error message. Oracle: we know which byte we damaged, so
# the reported damage range must contain it, on the sequential, parallel and
# stdin paths. The byte sits two thirds in, past the first block, so the
# range must also start after byte 0.
damaged="$work_dir/damaged.bz2"
cp "$big_src.bz2" "$damaged" || die "cannot copy compressed input"
size=$(wc -c <"$damaged") || die "cannot measure $damaged"
off=$((size * 2 / 3))
orig_byte=$(od -An -tu1 -j "$off" -N1 "$damaged" | tr -d ' ')
printf "$(printf '\\%03o' $((orig_byte ^ 255)))" | dd of="$damaged" bs=1 seek="$off" conv=notrunc status=none || die "cannot damage $damaged"

diag_re='(INVALID_DATA|CRC_MISMATCH) at byte ([0-9]+) bit ([0-7]) \(stream ([0-9]+), block ([0-9]+), phase ([a-z_]+)\)(; stored CRC 0x[0-9a-f]{8}, computed 0x[0-9a-f]{8})?; damage within bytes ([0-9]+)\.\.([0-9]+)$'
check_diag() {
	local label="$1"
	if [ "$rc" -ne 1 ]; then
		fail "$label: damaged input exited $rc"
		return
	fi
	if [[ ! "$err" =~ $diag_re ]]; then
		fail "$label: no diagnostics in: $err"
		return
	fi
	local at="${BASH_REMATCH[2]}" from="${BASH_REMATCH[8]}" to="${BASH_REMATCH[9]}"
	[ "$from" -le "$off" ] && [ "$off" -le "$to" ] || fail "$label: damaged byte $off outside reported range $from..$to"
	[ "$from" -gt 0 ] || fail "$label: damage range starts at byte 0 for damage past the first block"
	[ "$at" -ge "$to" ] || fail "$label: detection byte $at precedes range end $to"
}
capture "$cli" -t "$damaged"
check_diag "sequential -t"
capture "$cli" -j 2 -t "$damaged"
check_diag "parallel -t"
capture bash -c '"$1" -t <"$2"' _ "$cli" "$damaged"
check_diag "stdin -t"

# Trailing data: bytes after the last complete stream get their own status
# and extent. Oracle: we know how many bytes we appended, and where.
streams_size=$(wc -c <"$big_src.bz2") || die "cannot measure $big_src.bz2"
check_trailing() {
	local label="$1" length="$2" shape="$3"
	if [ "$rc" -ne 1 ]; then
		fail "$label: trailing data exited $rc"
		return
	fi
	local want="TRAILING_DATA: $length bytes at byte $streams_size after [0-9]+ complete streams? \\($shape\\)$"
	[[ "$err" =~ $want ]] || fail "$label: expected /$want/ in: $err"
}
padded="$work_dir/padded.bz2"
{ cat "$big_src.bz2"; head -c 100 /dev/zero; } >"$padded" || die "cannot write $padded"
partial="$work_dir/partial-header.bz2"
{ cat "$big_src.bz2"; printf 'BZ'; } >"$partial" || die "cannot write $partial"
foreign="$work_dir/foreign.bz2"
{ cat "$big_src.bz2"; printf 'not a bzip2 stream'; } >"$foreign" || die "cannot write $foreign"
for jobs in 1 2; do
	capture "$cli" -j "$jobs" -t "$padded"
	check_trailing "-j $jobs -t zero padding" 100 "all zero"
	capture "$cli" -j "$jobs" -t "$partial"
	check_trailing "-j $jobs -t partial header" 2 "starts like a stream header"
	capture "$cli" -j "$jobs" -t "$foreign"
	check_trailing "-j $jobs -t foreign bytes" 18 "not zero, not a stream header"
done
capture bash -c '"$1" -t <"$2"' _ "$cli" "$padded"
check_trailing "stdin -t zero padding" 100 "all zero"

# Warn, not silently ignore, when the source cannot be removed. Reference
# bzip2 prints "Couldn't remove" in this case, keeps the output and exits 0.
# The source must be unremovable while its directory stays writable (the
# output goes there), which without root takes an immutable file flag:
# macOS chflags. Elsewhere (Linux needs root for chattr +i) it is skipped.
if [ "$(uname -s)" = "Darwin" ]; then
	noremove_src="$work_dir/noremove.txt"
	printf 'cannot remove me after compressing' >"$noremove_src" || die "cannot write $noremove_src"
	if ! chflags uchg "$noremove_src"; then
		fail "unremovable source: chflags uchg failed on macOS"
	else
		capture "$cli" "$noremove_src"
		chflags nouchg "$noremove_src" || die "cannot clear immutable flag on $noremove_src"
		[ "$rc" -eq 0 ] || fail "unremovable source: compress exited $rc"
		[ -f "$noremove_src.bz2" ] || fail "unremovable source: compressed output missing"
		[ -f "$noremove_src" ] || fail "unremovable source: source vanished despite immutable flag"
		case "$err" in
			*"could not remove"*"$noremove_src"*) : ;;
			*) fail "unremovable source: expected a stderr warning, got: [$err]" ;;
		esac
	fi
fi

if [ "$failures" -ne 0 ]; then
	echo "cli_test: $failures failure(s)" >&2
	exit 1
fi
