#!/usr/bin/env luajit
-- Bounded differential sweep: mutates a deterministic pristine corpus and compares the exit status of
-- `bzip2z -t` (ReleaseSafe, so overflow panics surface as crashes) with the
-- reference `bzip2 -t`, used purely as a black-box oracle.
--
-- Usage: tests/differential/sniper-vs-reference [--mode sniper|shotgun|nuke]
--          [--seed N] [--cases N] BZIP2Z_BIN [REFERENCE_BIN]
-- sniper (default) flips every bit (a stride on the large stream); shotgun and
-- nuke run --cases seeded cases per corpus stream (see mutation.lua), skipping
-- streams shorter than the window and recording them as not run.
-- Prints one JSON summary line to stdout and each disagreement to stderr.
-- Exit status: 0 when no disagreement and no crash, 1 otherwise. Mutants and
-- the corpus stay in a fresh directory under $TMPDIR for replay.

package.path = (arg[0]:match("^(.*)/[^/]*$") or ".") .. "/?.lua;" .. package.path
local classify = require("sniper_classify")
local mutation = require("mutation")

local DEFINITIONS = {
	sniper = "sniper/v1: one bit XOR 1; corpus seed 20261009",
	shotgun = "shotgun/v3-geometry: 16 distinct bits in a contained 32-byte window, splitmix64 draws; corpus seed 20261009",
	nuke = "nuke/v3-geometry: contained 4096-byte overwrite, splitmix64 bytes, identity redrawn; corpus seed 20261009",
}
-- classifier/v1 (cfd3b7c) flattened all nonzero non-signal exits into reject,
-- excused every second-header flip, and passed when both sides crashed.
-- classifier/v2 applies per-binary exit contracts, excuses only flips that
-- leave a later stream header invalid, and fails on any crash or error.
local CLASSIFIER = "classifier/v2"
local SEED = 20261009
local MULTI_BLOCK_STRIDE = 7 -- coprime with 8: every bit-in-byte position is hit

local USAGE = "usage: sniper-vs-reference [--mode sniper|shotgun|nuke] [--seed N] [--cases N] BZIP2Z_BIN [REFERENCE_BIN]"
local mode, mode_seed, cases = "sniper", 1, 200
local positional = {}
do
	local i = 1
	while i <= #arg do
		local a = arg[i]
		if a == "--mode" then mode = arg[i + 1]; i = i + 2
		elseif a == "--seed" then mode_seed = tonumber(arg[i + 1]); i = i + 2
		elseif a == "--cases" then cases = tonumber(arg[i + 1]); i = i + 2
		else positional[#positional + 1] = a; i = i + 1 end
	end
end
assert(DEFINITIONS[mode], USAGE)
assert(mode_seed and cases and cases > 0, USAGE)
local bzip2z = assert(positional[1], USAGE)
local reference = positional[2] or "bzip2"
local workdir = (os.getenv("TMPDIR") or "/tmp") .. "/sniper-vs-reference-" .. tostring(os.time()) .. "-" .. tostring(math.random(1e9))

local function sh(cmd)
	return classify.exit_code(os.execute(cmd))
end

local function capture(cmd)
	local p = assert(io.popen(cmd))
	local out = p:read("*a")
	p:close()
	return (out:gsub("%s+$", ""))
end

local function read_file(path)
	local f = assert(io.open(path, "rb"))
	local data = f:read("*a")
	f:close()
	return data
end

local function write_file(path, data)
	local f = assert(io.open(path, "wb"))
	f:write(data)
	f:close()
end

-- Deterministic pseudo-random text from a fixed 31-bit LCG.
local function lcg_text(seed, length)
	local words = { "alpha", "block", "crc", "huffman", "run", "length", "stream", "bwt", "mtf", "zero", "\n" }
	local x, parts, size = seed, {}, 0
	while size < length do
		x = (x * 1103515245 + 12345) % 2147483648
		local w = words[(x % #words) + 1]
		parts[#parts + 1] = w .. " "
		size = size + #w + 1
	end
	return table.concat(parts):sub(1, length)
end

local function pattern_bytes(length)
	local t = {}
	for i = 0, length - 1 do
		t[#t + 1] = string.char(((i * 7) % 251 + math.floor(i / 5000)) % 256)
	end
	return table.concat(t)
end

local function verdict(bin, path, contract)
	return classify.verdict_from_exit(sh(string.format("%q -t %q >/dev/null 2>&1", bin, path)), contract)
end

local function flip(data, bit)
	local byte_index = math.floor(bit / 8) + 1
	local b = data:byte(byte_index)
	local m = 2 ^ (7 - bit % 8)
	local flipped = (math.floor(b / m) % 2 == 1) and (b - m) or (b + m)
	return data:sub(1, byte_index - 1) .. string.char(flipped) .. data:sub(byte_index + 1)
end

assert(sh("mkdir -p " .. string.format("%q", workdir)) == 0)

-- Pristine corpus, encoded by the reference encoder.
write_file(workdir .. "/text.txt", lcg_text(SEED, 1500))
write_file(workdir .. "/second.txt", lcg_text(SEED + 1, 300))
write_file(workdir .. "/pattern.bin", pattern_bytes(101000))
assert(sh(string.format("%q -9 -c %q > %q", reference, workdir .. "/text.txt", workdir .. "/text.bz2")) == 0)
assert(sh(string.format("%q -9 -c %q > %q", reference, workdir .. "/second.txt", workdir .. "/second.bz2")) == 0)
assert(sh(string.format("%q -1 -c %q > %q", reference, workdir .. "/pattern.bin", workdir .. "/pattern.bz2")) == 0)
if mode ~= "sniper" then
	-- Seeded incompressible bytes: streams long enough to hold a nuke window,
	-- one single-block and one two-block (level 1).
	local r = mutation.rng(SEED)
	local function noise(n) local t = {} for i = 1, n do t[i] = string.char(r.below(256)) end return table.concat(t) end
	write_file(workdir .. "/noise8k.bin", noise(8000))
	write_file(workdir .. "/noise150k.bin", noise(150000))
	assert(sh(string.format("%q -9 -c %q > %q", reference, workdir .. "/noise8k.bin", workdir .. "/noise8k.bz2")) == 0)
	assert(sh(string.format("%q -1 -c %q > %q", reference, workdir .. "/noise150k.bin", workdir .. "/noise150k.bz2")) == 0)
end

local corpus = {
	{ name = "text-1500-l9", data = read_file(workdir .. "/text.bz2"), stride = 1 },
	-- Reference bzip2 treats data after a complete stream that is not a valid
	-- stream header as ignorable trailing garbage (exit 0); bzip2z reports it.
	-- That one documented divergence is expected only inside the second
	-- stream's 32-bit "BZh<digit>" header.
	{ name = "two-streams", data = read_file(workdir .. "/text.bz2") .. read_file(workdir .. "/second.bz2"), stride = 1,
		trailing_header_bits = { #read_file(workdir .. "/text.bz2") * 8, #read_file(workdir .. "/text.bz2") * 8 + 31 } },
	{ name = "pattern-101000-l1-two-blocks", data = read_file(workdir .. "/pattern.bz2"), stride = MULTI_BLOCK_STRIDE },
}
if mode ~= "sniper" then
	corpus[#corpus + 1] = { name = "noise-8000-l9", data = read_file(workdir .. "/noise8k.bz2"), stride = 1 }
	corpus[#corpus + 1] = { name = "noise-150000-l1-two-blocks", data = read_file(workdir .. "/noise150k.bz2"), stride = 1 }
end

local totals = { trials = 0, both_accept = 0, both_reject = 0, intentional_divergence = 0, experiment_error = 0, bzip2z_only_reject = 0, reference_only_reject = 0, bzip2z_crash = 0, reference_crash = 0 }
local entries = {}
local exit_status = 0
local not_run = {}
local mutant = workdir .. "/mutant.bz2"

for index, item in ipairs(corpus) do
	local pristine = workdir .. "/" .. item.name .. ".bz2"
	write_file(pristine, item.data)
	local control_ours, control_ref = verdict(bzip2z, pristine, classify.CONTRACTS.bzip2z), verdict(reference, pristine, classify.CONTRACTS.reference)
	if control_ours ~= "accept" or control_ref ~= "accept" then
		io.stderr:write(string.format("CONTROL FAILED %s: bzip2z=%s reference=%s\n", item.name, control_ours, control_ref))
		exit_status = 1
	end
	local sha = capture(string.format("sha256sum %q | cut -d' ' -f1", pristine))
	entries[#entries + 1] = string.format('{"name":"%s","bytes":%d,"stride":%d,"sha256":"%s","control":"%s/%s"}', item.name, #item.data, item.stride, sha, control_ours, control_ref)

	-- One trial: run both binaries on MUTATED and classify; DESCRIBE names the
	-- case in log lines (bit index, or seed/case/offset for damage modes).
	local function trial(mutated, describe)
		write_file(mutant, mutated)
		local ours, ref = verdict(bzip2z, mutant, classify.CONTRACTS.bzip2z), verdict(reference, mutant, classify.CONTRACTS.reference)
		totals.trials = totals.trials + 1
		if ours == "crash" then totals.bzip2z_crash = totals.bzip2z_crash + 1 end
		if ref == "crash" then totals.reference_crash = totals.reference_crash + 1 end
		-- Only a mutation that left the second stream header invalid can be the
		-- documented trailing-garbage divergence (a sniper flip must lie inside
		-- the header to do that).
		local window = item.trailing_header_bits
		local header_start = window and math.floor(window[1] / 8) + 1
		local excusable = window ~= nil and not classify.header_is_valid(mutated:sub(header_start, header_start + 3))
		local outcome, fails = classify.classify(ours, ref, excusable)
		-- Crashes are tallied per side above; count every other outcome here.
		if totals[outcome] and not outcome:find("crash", 1, true) then totals[outcome] = totals[outcome] + 1 end
		if outcome == "both_accept" then
			-- Undetected by both: the residual blind class. Logged, not a failure.
			io.stderr:write(string.format("BOTH-ACCEPT %s %s\n", item.name, describe()))
		end
		if fails then
			io.stderr:write(string.format("FAIL %s %s %s: bzip2z=%s reference=%s\n", outcome, item.name, describe(), ours, ref))
			exit_status = 1
		end
	end

	if mode == "sniper" then
		for bit = 0, #item.data * 8 - 1, item.stride do
			trial(flip(item.data, bit), function() return string.format("bit %d (byte %d of %d)", bit, math.floor(bit / 8), #item.data) end)
		end
	else
		-- Each stream gets its own generator, so adding a stream never shifts
		-- the cases of another.
		local rng = mutation.rng(mode_seed * 1000 + index)
		for case = 1, cases do
			local mutated, rec = mutation[mode](item.data, rng)
			if not mutated then
				not_run[#not_run + 1] = string.format('{"name":"%s","reason":"%s"}', item.name, rec)
				break
			end
			trial(mutated, function()
				local detail = rec.bits and ("bits " .. table.concat(rec.bits, ",")) or string.format("length %d redraws %d", rec.length, rec.redraws)
				return string.format("seed %d case %d offset %d %s", mode_seed, case, rec.offset, detail)
			end)
		end
	end
end

-- Damage modes add their seed, cases per stream and skipped streams; the
-- sniper summary keeps its original fields so recorded domains still match.
local mode_fields = ""
if mode ~= "sniper" then
	mode_fields = string.format('"seed":%d,"cases_per_stream":%d,"not_run":[%s],', mode_seed, cases, table.concat(not_run, ","))
end
print(string.format('{"definition":"%s","classifier":"%s","reference":"%s","corpus":[%s],%s"trials":%d,"both_accept":%d,"both_reject":%d,"intentional_divergence":%d,"experiment_error":%d,"bzip2z_only_reject":%d,"reference_only_reject":%d,"bzip2z_crash":%d,"reference_crash":%d}',
	DEFINITIONS[mode], CLASSIFIER, capture(string.format("%q --version 2>&1 </dev/null | head -1", reference)):gsub('"', "'"), table.concat(entries, ","), mode_fields,
	totals.trials, totals.both_accept, totals.both_reject, totals.intentional_divergence, totals.experiment_error, totals.bzip2z_only_reject, totals.reference_only_reject, totals.bzip2z_crash, totals.reference_crash))
os.exit(exit_status)
