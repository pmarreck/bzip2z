#!/usr/bin/env bash
# Deliberate replay of the differential evidence for the current commit:
# requires a clean tree, then runs ./test, builds the ReleaseSafe CLI and
# runs the sniper sweep, keeping every log, the report and identity hashes in
# a fresh private state directory outside $TMPDIR (which a build scheduler
# may delete when a job ends). Exits nonzero if any required step fails, the
# report is missing or empty of trials, or a prerequisite is unmet.
# Per-stage statuses are written to status.json in the state directory.
#
# Injection points (used by tests/differential/replay-runner-test):
#   REPLAY_STATE_DIR, REPLAY_TEST_CMD, REPLAY_BUILD_CMD, REPLAY_SWEEP_CMD,
#   REPLAY_BIN, REPLAY_REFERENCE
set -u

state_parent="${XDG_STATE_HOME:-$HOME/.local/state}/bzip2z-replays"
if [ -n "${REPLAY_STATE_DIR:-}" ]; then
	state="$REPLAY_STATE_DIR"
else
	mkdir -p "$state_parent" && state="$(mktemp -d "$state_parent/replay-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")"
fi
test_cmd="${REPLAY_TEST_CMD:-./test}"
build_cmd="${REPLAY_BUILD_CMD:-zig build -Doptimize=ReleaseSafe}"
sweep_cmd="${REPLAY_SWEEP_CMD:-tests/differential/sniper-vs-reference}"
bin="${REPLAY_BIN:-$PWD/zig-out/bin/bzip2z}"
reference="${REPLAY_REFERENCE:-$(command -v bzip2)}"

fail() { echo "replay-runner: $*" >&2; exit 2; }

# Prerequisites: a state directory that survives the job, and a clean tree.
state_abs="$(realpath -m "$state")"
tmp_abs="$(realpath -m "${TMPDIR:-/tmp}")"
case "$state_abs/" in "$tmp_abs"/*) fail "state directory $state_abs is inside TMPDIR $tmp_abs and could be deleted with the job" ;; esac
mkdir -p "$state" && chmod 700 "$state" || fail "cannot create state directory $state"
source_rev="$(git rev-parse HEAD 2>/dev/null)" || fail "not a git checkout"
dirty="$(git status --porcelain | wc -l)"
[ "$dirty" -eq 0 ] || fail "source tree has $dirty uncommitted change(s); replay needs an exact commit"
[ -n "$reference" ] || fail "reference bzip2 not found"

failures=0
stages=()
# stage NAME STATUS: record a stage's status (an exit code or "skipped").
stage() {
	stages+=("\"$1\": $( [ "$2" = skipped ] && echo '"skipped"' || echo "$2" )")
	[ "$2" = 0 ] || failures=$((failures + 1))
}

bash -c "$test_cmd" > "$state/test.log" 2>&1; stage test $?
bash -c "$build_cmd" > "$state/build.log" 2>&1; build_status=$?; stage build $build_status

report="$state/sweep.json"
if [ "$build_status" -eq 0 ]; then
	bash -c "$sweep_cmd \"\$1\" \"\$2\"" sweep "$bin" "$reference" > "$report" 2> "$state/sweep.err"; stage sweep $?
	# The report must exist, be labeled with its classifier and have trials.
	report_ok=1
	[ -s "$report" ] || report_ok=0
	grep -q '"classifier":"' "$report" 2>/dev/null || report_ok=0
	trials="$(sed -n 's/.*"trials":\([0-9][0-9]*\).*/\1/p' "$report" 2>/dev/null)"
	[ -n "$trials" ] && [ "$trials" -gt 0 ] || report_ok=0
	stage report "$( [ $report_ok -eq 1 ] && echo 0 || echo 1 )"
else
	stage sweep skipped
	stage report skipped
fi

sha() { [ -f "$1" ] && sha256sum "$1" | cut -d' ' -f1 || echo none; }
{
	printf '{\n'
	printf '  "source_rev": "%s",\n' "$source_rev"
	printf '  "binary_sha256": "%s",\n' "$(sha "$bin")"
	printf '  "reference": "%s",\n' "$reference"
	printf '  "report_sha256": "%s",\n' "$(sha "$report")"
	printf '  "stages": {%s},\n' "$(IFS=,; echo "${stages[*]}")"
	printf '  "failures": %d\n' "$failures"
	printf '}\n'
} | sed 's/{"/{ "/; s/,"/, "/g' > "$state/status.json"

echo "replay-runner: evidence in $state ($failures failed stage(s))" >&2
[ "$failures" -eq 0 ]
