#!/usr/bin/env bash
# Controls for tests/differential/replay-runner: with injected fake steps, a
# failing test, build or sweep, a missing or zero-trial report, a dirty source
# tree, or a state directory inside $TMPDIR must each make the runner fail.
# Only the all-good case may pass. Prints nothing on success.
set -u

runner="$(cd "$(dirname "$0")" && pwd)/replay-runner"
root="$(mktemp -d "${TMPDIR:-/tmp}/replay-runner-test.XXXXXX")"
failures=0

# A throwaway clean git repository stands in for the bzip2z checkout.
repo="$root/repo"
mkdir -p "$repo/out" && git -C "$repo" init -q && printf 'x\n' > "$repo/file" && printf 'out/\n' > "$repo/.gitignore"
git -C "$repo" add file .gitignore && git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m init
printf 'binary\n' > "$repo/out/bin"

# Fake sweep: behavior chosen by FAKE_SWEEP; arguments are BIN REF.
fake_sweep="$root/fake-sweep"
cat > "$fake_sweep" <<'SWEEP'
#!/usr/bin/env bash
case "${FAKE_SWEEP:-good}" in
	good) printf '{"definition":"d","classifier":"classifier/v2","trials":5}\n' ;;
	fail) printf '{"definition":"d","classifier":"classifier/v2","trials":5}\n'; exit 1 ;;
	missing) exit 0 ;;
	zero) printf '{"definition":"d","classifier":"classifier/v2","trials":0}\n' ;;
	unlabeled) printf '{"definition":"d","trials":5}\n' ;;
esac
SWEEP
chmod +x "$fake_sweep"

# run NAME EXPECT_ZERO [VAR=VALUE...]: runs the runner with fakes and checks
# whether its exit status is zero as expected.
run() {
	local name="$1" expect_zero="$2"; shift 2
	local state="$root/state-$name" jobtmp="$root/jobtmp-$name"
	mkdir -p "$jobtmp"
	(
		cd "$repo" || exit 99
		env TMPDIR="$jobtmp" REPLAY_STATE_DIR="$state" REPLAY_TEST_CMD=true REPLAY_BUILD_CMD=true \
			REPLAY_SWEEP_CMD="$fake_sweep" REPLAY_BIN="$repo/out/bin" REPLAY_REFERENCE=/bin/true "$@" "$runner"
	) > "$root/$name.out" 2>&1
	local rc=$?
	if [ "$expect_zero" = yes ] && [ $rc -ne 0 ]; then
		echo "FAIL $name: expected success, got exit $rc"; cat "$root/$name.out"; failures=$((failures + 1))
	elif [ "$expect_zero" = no ] && [ $rc -eq 0 ]; then
		echo "FAIL $name: expected failure, got exit 0"; cat "$root/$name.out"; failures=$((failures + 1))
	fi
}

run all-good yes
run test-fails no REPLAY_TEST_CMD=false
run build-fails no REPLAY_BUILD_CMD=false
run sweep-fails no FAKE_SWEEP=fail
run report-missing no FAKE_SWEEP=missing
run zero-trials no FAKE_SWEEP=zero
run report-unlabeled no FAKE_SWEEP=unlabeled

# Evidence of the good run: per-stage statuses and hashes in status.json.
status="$root/state-all-good/status.json"
if [ ! -s "$status" ] || ! grep -q '"test": 0' "$status" || ! grep -q '"sweep": 0' "$status" || ! grep -q '"binary_sha256": "[0-9a-f]\{64\}"' "$status"; then
	echo "FAIL all-good: status.json missing stage statuses or binary hash"; cat "$status" 2>/dev/null; failures=$((failures + 1))
fi
# A failed build must skip the sweep rather than test a stale binary.
if ! grep -q '"sweep": "skipped"' "$root/state-build-fails/status.json" 2>/dev/null; then
	echo "FAIL build-fails: sweep not recorded as skipped"; failures=$((failures + 1))
fi

# A state directory inside the job's TMPDIR would be deleted with it.
(
	cd "$repo" || exit 99
	env TMPDIR="$root" REPLAY_STATE_DIR="$root/inside-tmp" REPLAY_TEST_CMD=true REPLAY_BUILD_CMD=true \
		REPLAY_SWEEP_CMD="$fake_sweep" REPLAY_BIN="$repo/out/bin" REPLAY_REFERENCE=/bin/true "$runner"
) > "$root/inside-tmp.out" 2>&1 && { echo "FAIL state-inside-tmpdir: expected failure"; failures=$((failures + 1)); }

# A dirty source tree must abort before any step runs.
printf 'dirty\n' >> "$repo/file"
run dirty-source no
if [ -e "$root/state-dirty-source/test.log" ]; then echo "FAIL dirty-source: steps ran on a dirty tree"; failures=$((failures + 1)); fi

[ "$failures" -eq 0 ] || { echo "$failures replay-runner control(s) failed (scratch kept at $root)"; exit 1; }
mv "$root" "$HOME/.Trash/" 2>/dev/null || true
exit 0
