#!/usr/bin/env bash
# Controls for tests/differential/replay-runner, using injected fake steps in a
# throwaway repository. Every case except all-good must make the runner exit
# nonzero; all-good must also leave a parseable status.json with stage
# statuses and identities. Prints nothing on success.
set -u

runner="$(cd "$(dirname "$0")" && pwd)/replay-runner"
root="$(mktemp -d "${TMPDIR:-/tmp}/replay-runner-test.XXXXXX")"
failures=0

repo="$root/repo"
mkdir -p "$repo/out" && git -C "$repo" init -q && printf 'x\n' > "$repo/file" && printf 'out/\n' > "$repo/.gitignore"
git -C "$repo" add file .gitignore && git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m init
printf 'binary\n' > "$repo/out/bin"

# The declared domain the runner must enforce exactly.
manifest="$root/domain.json"
cat > "$manifest" <<'JSON'
{"definition":"d1","classifier":"classifier/v2","trials":24,
 "corpus":[{"name":"c","bytes":3,"stride":1,"sha256":"aa"}]}
JSON

# Fake sweep: prints a report chosen by FAKE_SWEEP, ignoring BIN and REF.
fake_sweep="$root/fake-sweep"
# Shebang from the running bash: build sandboxes have no /usr/bin/env.
printf '#!%s\n' "$BASH" > "$fake_sweep"
cat >> "$fake_sweep" <<'SWEEP'
good='{"definition":"d1","classifier":"classifier/v2","reference":"r","corpus":[{"name":"c","bytes":3,"stride":1,"sha256":"aa","control":"accept/accept"}],"trials":24,"both_accept":1,"both_reject":23,"intentional_divergence":0,"experiment_error":0,"bzip2z_only_reject":0,"reference_only_reject":0,"bzip2z_crash":0,"reference_crash":0}'
case "${FAKE_SWEEP:-good}" in
	good) echo "$good" ;;
	fail) echo "$good"; exit 1 ;;
	missing) exit 0 ;;
	zero) echo "$good" | sed 's/"trials":24/"trials":0/' ;;
	nonjson) echo 'definition d1 "classifier":"classifier/v2" "trials":24' ;;
	other-classifier) echo "$good" | sed 's#classifier/v2#classifier/v99#' ;;
	other-count) echo "$good" | sed 's/"trials":24/"trials":1/' ;;
	other-corpus) echo "$good" | sed 's/"sha256":"aa"/"sha256":"bb"/' ;;
	control-failed) echo "$good" | sed 's#accept/accept#accept/reject#' ;;
	empty-corpus) echo "$good" | jq -c '.corpus = []' ;;
	unreconciled) echo "$good" | jq -c '.both_reject = 0' ;;
	negative) echo "$good" | jq -c '.both_accept = -1 | .both_reject = 25' ;;
	fractional) echo "$good" | jq -c '.both_accept = 0.5 | .both_reject = 23.5' ;;
	string-count) echo "$good" | jq -c '.both_accept = "1"' ;;
	missing-counter) echo "$good" | jq -c 'del(.both_accept, .both_reject, .intentional_divergence)' ;;
	missing-failure-counter) echo "$good" | jq -c 'del(.reference_crash)' ;;
	two-roots) echo "$good" | jq -c '.experiment_error = 1'; echo "$good" ;;
	array-root) echo "[$good]" ;;
	whitespace) printf '\n  %s  \n\n' "$(echo "$good" | jq .)" ;;
	failing-outcome) echo "$good" | sed 's/"bzip2z_crash":0/"bzip2z_crash":1/' ;;
esac
SWEEP
chmod +x "$fake_sweep"
reference="$root/ref"; printf '#!/bin/sh\n' > "$reference"; chmod +x "$reference"
quoted_reference="$root/ref\"quoted"; cp "$reference" "$quoted_reference"

# run NAME EXPECT_ZERO [VAR=VALUE...]
run() {
	local name="$1" expect_zero="$2"; shift 2
	local jobtmp="$root/jobtmp-$name"
	mkdir -p "$jobtmp"
	# The outer group silences the shell's own "Killed" report for the
	# termination case; the runner's output still goes to $name.out.
	{ (
		cd "$repo" || exit 99
		env TMPDIR="$jobtmp" REPLAY_STATE_DIR="$root/state-$name" REPLAY_DOMAIN="$manifest" \
			REPLAY_TEST_CMD=true REPLAY_BUILD_CMD=true REPLAY_SWEEP_CMD="$fake_sweep" \
			REPLAY_BIN="$repo/out/bin" REPLAY_REFERENCE="$reference" "$@" "$runner"
	) > "$root/$name.out" 2>&1; } 2>/dev/null
	local rc=$?
	if [ "$expect_zero" = yes ] && [ $rc -ne 0 ]; then
		echo "FAIL $name: expected success, got exit $rc"; cat "$root/$name.out"; failures=$((failures + 1))
	elif [ "$expect_zero" = no ] && [ $rc -eq 0 ]; then
		echo "FAIL $name: expected failure, got exit 0"; cat "$root/$name.out"; failures=$((failures + 1))
	fi
}

run all-good yes
run test-fails no REPLAY_TEST_CMD=false
run build-fails no REPLAY_BUILD_CMD=false
run sweep-fails no FAKE_SWEEP=fail
run report-missing no FAKE_SWEEP=missing
run zero-trials no FAKE_SWEEP=zero
run report-not-json no FAKE_SWEEP=nonjson
run other-classifier no FAKE_SWEEP=other-classifier
run other-trial-count no FAKE_SWEEP=other-count
run other-corpus-hash no FAKE_SWEEP=other-corpus
run control-failed no FAKE_SWEEP=control-failed
run failing-outcome-count no FAKE_SWEEP=failing-outcome
run empty-corpus no FAKE_SWEEP=empty-corpus
run reference-missing no REPLAY_REFERENCE="$root/no-such-reference"
run unreconciled-partition no FAKE_SWEEP=unreconciled
run negative-counter no FAKE_SWEEP=negative
run fractional-counter no FAKE_SWEEP=fractional
run string-counter no FAKE_SWEEP=string-count
run missing-success-counters no FAKE_SWEEP=missing-counter
run missing-failure-counter no FAKE_SWEEP=missing-failure-counter
run two-json-roots no FAKE_SWEEP=two-roots
run array-root no FAKE_SWEEP=array-root
run one-root-with-whitespace yes FAKE_SWEEP=whitespace
run binary-missing no REPLAY_BIN="$repo/out/no-such-bin"
run build-moves-head no REPLAY_BUILD_CMD="git -c user.name=t -c user.email=t@t commit -q --allow-empty -m moved"
mkdir -p "$root/state-status-unwritable/status.json"
run status-unwritable no
# Termination mid-run (the build kills the runner) must leave the completed
# test stage on record and the receipt marked incomplete.
run terminated-in-build no REPLAY_BUILD_CMD='kill -KILL $PPID'
if ! jq -e '.stages.test == 0 and .complete == false' "$root/state-terminated-in-build/status.json" >/dev/null 2>&1; then
	echo "FAIL terminated-in-build: completed stage not durable or receipt not marked incomplete"; cat "$root/state-terminated-in-build/status.json" 2>/dev/null; failures=$((failures + 1))
fi
run quoted-reference yes REPLAY_REFERENCE="$quoted_reference"


# Damage modes (shotgun, nuke): the manifest declares mode, seed, cases per
# stream and the streams too short to run. The runner must pass them to the
# sweep and check that the report echoes them, with trials equal to cases
# times the streams that ran. The fake builds its report from its arguments,
# so a runner that drops them fails the seed and case checks.
damage_manifest="$root/damage-domain.json"
cat > "$damage_manifest" <<'JSON'
{"definition":"dmg1","classifier":"classifier/v2","mode":"shotgun","seed":7,"cases_per_stream":5,"trials":5,
 "not_run":["short"],
 "corpus":[{"name":"long","bytes":40,"stride":1,"sha256":"aa"},{"name":"short","bytes":3,"stride":1,"sha256":"bb"}]}
JSON
damage_sweep="$root/damage-sweep"
printf '#!%s\n' "$BASH" > "$damage_sweep"
cat >> "$damage_sweep" <<'SWEEP'
mode="" seed="" cases=""
while [ $# -gt 2 ]; do
	case "$1" in --mode) mode="$2"; shift 2 ;; --seed) seed="$2"; shift 2 ;; --cases) cases="$2"; shift 2 ;; *) shift ;; esac
done
[ "$mode" = shotgun ] || { echo "fake damage sweep: mode '$mode'" >&2; exit 1; }
good="$(jq -nc --argjson seed "${seed:-null}" --argjson cases "${cases:-null}" '{definition:"dmg1",classifier:"classifier/v2",reference:"r",
	corpus:[{name:"long",bytes:40,stride:1,sha256:"aa",control:"accept/accept"},{name:"short",bytes:3,stride:1,sha256:"bb",control:"accept/accept"}],
	seed:$seed,cases_per_stream:$cases,not_run:[{name:"short",reason:"input shorter than the shotgun window"}],
	trials:$cases,both_accept:0,both_reject:$cases,intentional_divergence:0,experiment_error:0,
	bzip2z_only_reject:0,reference_only_reject:0,bzip2z_crash:0,reference_crash:0}')"
case "${FAKE_SWEEP:-good}" in
	good) echo "$good" ;;
	other-seed) echo "$good" | jq -c '.seed = 8' ;;
	no-seed) echo "$good" | jq -c 'del(.seed)' ;;
	other-cases) echo "$good" | jq -c '.cases_per_stream = 4' ;;
	all-run) echo "$good" | jq -c '.not_run = []' ;;
	swapped-not-run) echo "$good" | jq -c '.not_run = [{name:"long",reason:"input shorter than the shotgun window"}]' ;;
	ghost-not-run) echo "$good" | jq -c '.not_run = [{name:"ghost",reason:"input shorter than the shotgun window"}]' ;;
	underived) echo "$good" | jq -c '.trials = 10 | .both_reject = 10' ;;
esac
SWEEP
chmod +x "$damage_sweep"
run damage-good yes REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep"
run damage-other-seed no REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=other-seed
run damage-missing-seed no REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=no-seed
run damage-other-cases no REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=other-cases
run damage-not-run-differs no REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=all-run
run damage-trials-not-derived no REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=underived
run damage-swapped-not-run no REPLAY_DOMAIN="$damage_manifest" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=swapped-not-run
# A manifest whose declared total disagrees with cases x streams run is
# itself wrong, even when the report repeats that total.
jq -c '.trials = 10' "$damage_manifest" > "$root/damage-domain-inconsistent.json"
run damage-inconsistent-manifest no REPLAY_DOMAIN="$root/damage-domain-inconsistent.json" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=underived
# A skipped stream must be one of the corpus streams.
jq -c '.not_run = ["ghost"]' "$damage_manifest" > "$root/damage-domain-ghost.json"
run damage-ghost-not-run no REPLAY_DOMAIN="$root/damage-domain-ghost.json" REPLAY_SWEEP_CMD="$damage_sweep" FAKE_SWEEP=ghost-not-run
# Each damage control must fail at the report check, after a successful
# sweep, so the cases test the report rules rather than an argument error.
for name in damage-other-seed damage-missing-seed damage-other-cases damage-not-run-differs damage-trials-not-derived damage-swapped-not-run damage-inconsistent-manifest damage-ghost-not-run; do
	if ! jq -e '.stages.sweep == 0 and .stages.report != 0' "$root/state-$name/status.json" >/dev/null 2>&1; then
		echo "FAIL $name: not rejected by the report check"; jq -c .stages "$root/state-$name/status.json" 2>/dev/null; failures=$((failures + 1))
	fi
done
# A sniper report must not satisfy a damage manifest.
run damage-given-sniper-report no REPLAY_DOMAIN="$damage_manifest"
# Good runs must leave a parseable status.json with stages and identities.
for name in all-good quoted-reference; do
	status="$root/state-$name/status.json"
	if ! jq -e '.stages.test == 0 and .stages.build == 0 and .stages.sweep == 0 and .stages.report == 0
		and (.binary_sha256 | test("^[0-9a-f]{64}$")) and (.report_sha256 | test("^[0-9a-f]{64}$"))
		and (.source_rev | test("^[0-9a-f]{40}$")) and .failures == 0 and .complete == true' "$status" >/dev/null 2>&1; then
		echo "FAIL $name: status.json unparseable or incomplete"; cat "$status" 2>/dev/null; failures=$((failures + 1))
	fi
done
if ! jq -e '.reference | endswith("ref\"quoted")' "$root/state-quoted-reference/status.json" >/dev/null 2>&1; then
	echo "FAIL quoted-reference: reference path not preserved"; failures=$((failures + 1))
fi
if ! jq -e '.stages.sweep == "skipped"' "$root/state-build-fails/status.json" >/dev/null 2>&1; then
	echo "FAIL build-fails: sweep not recorded as skipped"; failures=$((failures + 1))
fi

# A state directory inside the job's TMPDIR would be deleted with it.
(
	cd "$repo" || exit 99
	env TMPDIR="$root" REPLAY_STATE_DIR="$root/inside-tmp" REPLAY_DOMAIN="$manifest" REPLAY_TEST_CMD=true \
		REPLAY_BUILD_CMD=true REPLAY_SWEEP_CMD="$fake_sweep" REPLAY_BIN="$repo/out/bin" REPLAY_REFERENCE="$reference" "$runner"
) > "$root/inside-tmp.out" 2>&1 && { echo "FAIL state-inside-tmpdir: expected failure"; failures=$((failures + 1)); }

# A dirty source tree must abort before any step runs (last: it dirties repo).
printf 'dirty\n' >> "$repo/file"
run dirty-source no
if [ -e "$root/state-dirty-source/test.log" ]; then echo "FAIL dirty-source: steps ran on a dirty tree"; failures=$((failures + 1)); fi

[ "$failures" -eq 0 ] || { echo "$failures replay-runner control(s) failed (scratch kept at $root)"; exit 1; }
mv "$root" "$HOME/.Trash/" 2>/dev/null || true
exit 0
